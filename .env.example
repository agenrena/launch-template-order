SECRET_KEY=GENERATE_SECRET_KEY
POSTGRES_PASSWORD=GENERATE_DATABASE_PASSWORD
ALLOWED_HOSTS=localhost,127.0.0.1,backend
CSRF_TRUSTED_ORIGINS=http://localhost:8084,http://127.0.0.1:8084
COOKIE_SECURE=false
BIND_ADDRESS=127.0.0.1
PORT=8084
# Agenrena Vendor credentials for this App, issued by Agenrena. Keep private;
# leave empty to run without Agenrena.
AGENRENA_VENDOR_ID=
AGENRENA_VENDOR_SECRET=
# Customer entrance (docs/publish.md). Leave both empty until a tunnel publishes it:
# customers' phones cannot open this computer, so no table QR codes or Agent links.
# PUBLIC_PORT serves only the ordering pages on 127.0.0.1, for the tunnel to point at;
# ORDER_PUBLIC_BASE_URL is the address customers open, e.g. https://order.example.com
# (Docker Compose serves everything on one site and defaults this to localhost:8084).
PUBLIC_PORT=
ORDER_PUBLIC_BASE_URL=

# Optional persistent photo directory (local default: data/media/).
# MEDIA_ROOT=/absolute/path/to/menu-media
